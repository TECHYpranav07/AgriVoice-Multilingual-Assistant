# ========================================================
# Voice-First Multilingual Agricultural Assistant (.env)
# ========================================================

# --- LLM Providers (At least one is recommended, or local fallback will be used) ---
# Free Google Gemini API Key from: https://aistudio.google.com/
GEMINI_API_KEY=

# Free Groq API Key (ultra-fast Whisper & Llama) from: https://console.groq.com/
GROQ_API_KEY=

# Optional OpenAI API Key
OPENAI_API_KEY=

# --- Live Data APIs (100% Free) ---
# Agmarknet / Data.gov.in API key from: https://data.gov.in/
DATA_GOV_IN_API_KEY=

# OpenWeatherMap API key (Optional; Open-Meteo is used by default with ZERO keys needed)
OPENWEATHER_API_KEY=

# --- WhatsApp Cloud API (Meta for Developers) ---
# Free Test Access Token & Phone Number ID from https://developers.facebook.com/
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=agri_assistant_secret_token_123

# --- Application Configuration ---
DEFAULT_LANGUAGE=hi
AUDIO_STORAGE_PATH=./data/audio_temp
VECTOR_DB_PATH=./data/vector_store
KNOWLEDGE_DOCS_PATH=./data/raw_docs
